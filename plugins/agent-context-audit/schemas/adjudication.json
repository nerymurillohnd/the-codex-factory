{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target_id": {
            "type": "string"
          },
          "target_digest": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "kept",
              "revised",
              "rejected",
              "upheld-over-objection"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "repository-fact",
                    "official-document",
                    "native-default",
                    "related-directive",
                    "model-judgment"
                  ]
                },
                "ref": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "ref",
                "quote"
              ],
              "additionalProperties": false
            }
          },
          "counterevidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "repository-fact",
                    "official-document",
                    "native-default",
                    "related-directive",
                    "model-judgment"
                  ]
                },
                "ref": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "ref",
                "quote"
              ],
              "additionalProperties": false
            }
          },
          "finding": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "category": {
                    "type": "string",
                    "enum": [
                      "false",
                      "wrong",
                      "obsolete",
                      "dead",
                      "ambiguous",
                      "duplicated",
                      "overlapping",
                      "misplaced",
                      "contradictory",
                      "redundant-with-defaults",
                      "non-conformant"
                    ]
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "critical",
                      "high",
                      "medium",
                      "low",
                      "info"
                    ]
                  },
                  "confidence": {
                    "type": "string",
                    "enum": [
                      "high",
                      "medium",
                      "low"
                    ]
                  },
                  "title": {
                    "type": "string"
                  },
                  "source_id": {
                    "type": "string"
                  },
                  "line_start": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "line_end": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "excerpt": {
                    "type": "string"
                  },
                  "related": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "source_id": {
                          "type": "string"
                        },
                        "line_start": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "line_end": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "required": [
                        "source_id",
                        "line_start",
                        "line_end"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "conflicts_with": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "type": "array",
