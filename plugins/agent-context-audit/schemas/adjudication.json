                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "repository-fact",
                            "official-document",
                            "native-default",
                            "related-directive",
                            "model-judgment"
                          ]
                        },
                        "ref": {
                          "type": "string"
                        },
                        "quote": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind",
                        "ref",
                        "quote"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "impact": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "enum": [
                        "correctness",
                        "reliability",
                        "context-cost",
                        "maintenance"
                      ]
                    }
                  },
                  "disposition": {
                    "type": "string",
                    "enum": [
                      "keep",
                      "remove",
                      "merge",
                      "move",
                      "revise",
                      "investigate"
                    ]
                  },
                  "target_location": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "replacement": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "rationale": {
                    "type": "string"
                  },
                  "tradeoffs": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "subject": {
                    "type": "string"
                  },
                  "observation_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "category",
                  "severity",
                  "confidence",
                  "title",
                  "source_id",
                  "line_start",
                  "line_end",
                  "excerpt",
                  "related",
                  "conflicts_with",
                  "evidence",
                  "impact",
                  "disposition",
                  "target_location",
                  "replacement",
                  "rationale",
                  "tradeoffs",
                  "tags",
                  "subject",
                  "observation_ids"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "observation_decision": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "observation_id": {
                    "type": "string"
                  },
                  "outcome": {
                    "type": "string",
                    "enum": [
                      "confirmed",
                      "dismissed",
                      "reframed",
                      "unresolved"
                    ]
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "finding_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "observation_id",
                  "outcome",
                  "rationale",
                  "evidence_refs",
                  "finding_ids"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "target_id",
          "target_digest",
          "action",
          "rationale",
          "evidence",
          "counterevidence",
          "finding",
