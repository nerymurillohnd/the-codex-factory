{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "false",
              "wrong",
              "obsolete",
              "dead",
              "ambiguous",
              "duplicated",
              "overlapping",
              "misplaced",
              "contradictory",
              "redundant-with-defaults",
              "non-conformant"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "title": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "excerpt": {
            "type": "string"
          },
          "related": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string"
                },
                "line_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "line_end": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "source_id",
                "line_start",
                "line_end"
              ],
              "additionalProperties": false
            }
          },
          "conflicts_with": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "repository-fact",
                    "official-document",
                    "native-default",
                    "related-directive",
                    "model-judgment"
                  ]
                },
                "ref": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "ref",
                "quote"
              ],
              "additionalProperties": false
            }
          },
          "impact": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "correctness",
                "reliability",
                "context-cost",
                "maintenance"
              ]
            }
          },
          "disposition": {
            "type": "string",
            "enum": [
              "keep",
              "remove",
              "merge",
              "move",
              "revise",
              "investigate"
            ]
          },
          "target_location": {
            "type": [
              "string",
              "null"
            ]
          },
          "replacement": {
            "type": [
              "string",
              "null"
            ]
          },
          "rationale": {
            "type": "string"
          },
          "tradeoffs": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "subject": {
            "type": "string"
          },
          "observation_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "category",
          "severity",
          "confidence",
          "title",
          "source_id",
          "line_start",
          "line_end",
          "excerpt",
          "related",
          "conflicts_with",
          "evidence",
          "impact",
          "disposition",
          "target_location",
          "replacement",
          "rationale",
          "tradeoffs",
          "tags",
          "subject",
          "observation_ids"
        ],
        "additionalProperties": false
      }
    },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "directive_id": {
            "type": "string"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "keep",
              "remove",
              "merge",
              "move",
              "revise",
              "investigate"
            ]
          },
          "rationale": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "directive_id",
          "disposition",
          "rationale",
          "evidence_refs"
        ],
        "additionalProperties": false
      }
    },
    "considered_job_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contested": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "job_id",
          "subject",
          "reason",
          "evidence_refs"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_key": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "enum": [
              "kept",
              "rejected",
              "merged",
              "contested"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "final_finding_indexes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "uniqueItems": true
          }
        },
        "required": [
          "finding_key",
          "decision",
          "rationale",
          "evidence_refs",
          "final_finding_indexes"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observation_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "observation_id": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "confirmed",
              "dismissed",
              "reframed",
              "unresolved"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "finding_indexes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "required": [
          "observation_id",
          "outcome",
          "rationale",
          "evidence_refs",
          "finding_indexes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "findings",
    "dispositions",
    "considered_job_ids",
    "contested",
    "limitations",
    "decisions",
    "notes",
    "observation_decisions"
  ],
  "additionalProperties": false
}
