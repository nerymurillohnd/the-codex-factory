{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.1"
    },
    "plugin_version": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "repository_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "entry_mode": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete-clean",
        "complete-with-findings",
        "partial",
        "failed"
      ]
    },
    "report_path": {
      "type": "string"
    },
    "model_resolved": {
      "type": "string"
    },
    "exit_code": {
      "type": "integer",
      "enum": [
        0,
        1,
        2,
        3
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "canonical_path": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "load_mode": {
            "type": "string"
          },
          "provenance": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "hosts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "line_count": {
            "type": "integer",
            "minimum": 0
          },
          "byte_count": {
            "type": "integer",
            "minimum": 0
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "target": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "minimum": 0
                },
                "kind": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                },
                "resolved": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "target",
                "line",
                "kind",
                "state",
                "resolved"
              ],
              "additionalProperties": false
            }
          },
          "redacted_lines": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "contexts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "source_id",
          "path",
          "canonical_path",
          "scope",
          "domain",
          "load_mode",
          "provenance",
          "sha256",
          "status",
          "reason",
          "hosts",
          "line_count",
          "byte_count",
          "references",
          "redacted_lines",
          "contexts"
        ],
        "additionalProperties": false,
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chunk_id": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "line_start": {
            "type": "integer",
            "minimum": 0
          },
          "line_end": {
            "type": "integer",
            "minimum": 0
          },
          "byte_start": {
            "type": "integer",
            "minimum": 0
          },
          "byte_end": {
            "type": "integer",
            "minimum": 0
          },
          "payload_sha256": {
            "type": "string"
          }
        },
        "required": [
          "chunk_id",
          "source_id",
          "line_start",
          "line_end",
          "byte_start",
          "byte_end",
          "payload_sha256"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "false",
              "wrong",
              "obsolete",
              "dead",
              "ambiguous",
              "duplicated",
              "overlapping",
              "misplaced",
              "contradictory",
              "redundant-with-defaults",
              "non-conformant"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "title": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "excerpt": {
            "type": "string"
          },
          "related": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string"
                },
                "line_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "line_end": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "source_id",
                "line_start",
                "line_end"
              ],
              "additionalProperties": false
            }
          },
          "conflicts_with": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "repository-fact",
                    "official-document",
                    "native-default",
                    "related-directive",
                    "model-judgment"
                  ]
                },
                "ref": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "ref",
                "quote"
              ],
              "additionalProperties": false
            }
          },
          "impact": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "correctness",
                "reliability",
                "context-cost",
                "maintenance"
              ]
            }
          },
          "disposition": {
            "type": "string",
            "enum": [
              "keep",
              "remove",
              "merge",
              "move",
              "revise",
              "investigate"
            ]
          },
          "target_location": {
            "type": [
              "string",
              "null"
            ]
          },
          "replacement": {
            "type": [
              "string",
              "null"
            ]
          },
          "rationale": {
            "type": "string"
          },
          "tradeoffs": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "subject": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "observation_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "category",
          "severity",
          "confidence",
          "title",
          "source_id",
          "line_start",
          "line_end",
          "excerpt",
          "related",
          "conflicts_with",
          "evidence",
          "impact",
          "disposition",
          "target_location",
          "replacement",
          "rationale",
          "tradeoffs",
          "tags",
          "subject",
          "id"
        ],
        "additionalProperties": false
      }
    },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "directive_id": {
            "type": "string"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "keep",
              "remove",
              "merge",
              "move",
              "revise",
              "investigate"
            ]
          },
          "rationale": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "directive_id",
          "disposition",
          "rationale",
          "evidence_refs"
        ],
        "additionalProperties": false
      }
    },
    "considered_job_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_key": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "enum": [
              "kept",
              "rejected",
              "merged",
              "contested"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "batch": {
            "type": "integer",
            "minimum": 0
          },
          "final_finding_indexes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "uniqueItems": true
          },
          "final_finding_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "adjudicated_finding_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "finding_key",
          "decision",
          "rationale",
          "evidence_refs",
          "final_finding_indexes",
          "final_finding_ids"
        ],
        "additionalProperties": false
      }
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "dissent": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validators": {
      "type": "object"
    },
    "baseline_changes": {
      "type": "object",
      "properties": {
        "new": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resolved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "persisting": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "regressed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unassessed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "new",
        "resolved",
        "persisting",
        "regressed",
        "unassessed"
      ],
      "additionalProperties": false
    },
    "baseline_history": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "new",
          "resolved",
          "persisting",
          "regressed"
        ]
      }
    },
    "knowledge": {
      "type": "object"
    },
    "knowledge_observations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "git_before": {
      "type": "object"
    },
    "git_after": {
      "type": "object"
    },
    "model_requested": {
      "type": [
        "string",
        "null"
      ]
    },
    "effort_requested": {
      "type": [
        "string",
        "null"
      ]
    },
    "codex_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "wall_seconds": {
      "type": "number",
      "minimum": 0
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claude_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "invocation_cwd": {
      "type": "string"
    },
    "evidence_path": {
      "type": "string"
    },
    "output_in_target": {
      "type": "boolean"
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "observation_decisions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "semantic_assessments": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "adjudications": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "scope_fingerprint": {
      "type": "string"
    },
    "repository_evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "schema_version",
    "plugin_version",
    "run_id",
    "repository_id",
    "created_at",
    "target",
    "cwd",
    "entry_mode",
    "status",
    "report_path",
    "model_resolved",
    "exit_code",
    "sources",
    "exclusions",
    "chunks",
    "findings",
    "dispositions",
    "considered_job_ids",
    "decisions",
    "candidate_count",
    "dissent",
    "limitations",
    "validators",
    "baseline_changes",
    "baseline_history",
    "knowledge",
    "knowledge_observations",
    "git_before",
    "git_after",
    "model_requested",
    "effort_requested",
    "codex_version",
    "jobs",
    "wall_seconds",
    "notes",
    "claude_version",
    "observations",
    "observation_decisions",
    "semantic_assessments",
    "adjudications",
    "scope_fingerprint",
    "repository_evidence"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
