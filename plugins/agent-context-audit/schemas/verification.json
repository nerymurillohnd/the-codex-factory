{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "needs-evidence",
        "failed"
      ]
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target_id": {
            "type": "string"
          },
          "target_digest": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "supported",
              "challenged",
              "unverifiable"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "repository-fact",
                    "official-document",
                    "native-default",
                    "related-directive",
                    "model-judgment"
                  ]
                },
                "ref": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "ref",
                "quote"
              ],
              "additionalProperties": false
            }
          },
          "counterevidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "repository-fact",
                    "official-document",
                    "native-default",
                    "related-directive",
                    "model-judgment"
                  ]
                },
                "ref": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "ref",
                "quote"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "target_id",
          "target_digest",
          "verdict",
          "rationale",
          "evidence",
          "counterevidence"
        ],
        "additionalProperties": false
      }
    },
    "evidence_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "line_start",
          "line_end",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "status",
    "assessments",
    "evidence_requests",
    "limitations",
    "notes"
  ],
  "additionalProperties": false
}
