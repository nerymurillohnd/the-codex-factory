{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|clear)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/session-bootstrap.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for a session handoff"
          }
        ]
      }
    ]
  }
}
